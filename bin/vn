#!/usr/bin/env bash
# vn — VoiceNotes: workday audio capture, local transcription, calendar-linked notes.
set -uo pipefail

# Resolve through symlinks (vn is normally linked into ~/.local/bin)
_src="${BASH_SOURCE[0]}"
while [ -L "$_src" ]; do
  _dir="$(cd -P "$(dirname "$_src")" && pwd)"
  _src="$(readlink "$_src")"
  [[ "$_src" != /* ]] && _src="$_dir/$_src"
done
VN_LIB="$(cd -P "$(dirname "$_src")/../lib" && pwd)"
source "$VN_LIB/common.sh"

BOLD=$'\033[1m'; DIM=$'\033[2m'; RED=$'\033[31m'; GRN=$'\033[32m'; YEL=$'\033[33m'; OFF=$'\033[0m'
ok(){ echo "${GRN}✓${OFF} $*"; }
no(){ echo "${RED}✗${OFF} $*"; }
warn(){ echo "${YEL}!${OFF} $*"; }

usage(){ cat <<EOF
${BOLD}vn${OFF} — VoiceNotes

  ${BOLD}vn start${OFF} [secs]   Record now (default: until ${VN_END_HOUR}:00)
  ${BOLD}vn stop${OFF}           Stop recording
  ${BOLD}vn status${OFF}         What's running, today's capture, disk use
  ${BOLD}vn devices${OFF}        List input devices
  ${BOLD}vn doctor${OFF}         Check dependencies, permissions, config

  ${BOLD}vn transcribe${OFF} [day]   Transcribe segments (default: today)
  ${BOLD}vn notes${OFF} [day]        Build calendar-linked notes
  ${BOLD}vn today${OFF}              Transcribe + notes + show index
  ${BOLD}vn show${OFF} [day]         Print the day's index
  ${BOLD}vn read${OFF} [day]         Print the day's full transcript
  ${BOLD}vn note${OFF} <n|name>      Print one meeting's note
  ${BOLD}vn open${OFF} [day]         Open the notes folder in Finder

  ${BOLD}vn schedule on|off${OFF}    Enable/disable the ${VN_START_HOUR}:00 daily job
  ${BOLD}vn purge${OFF}              Compress audio, apply retention
  ${BOLD}vn setup-model${OFF}        Download the Whisper model
  ${BOLD}vn uninstall${OFF}          Remove schedule (keeps your data)

Config: ${VN_CONF}
Data:   ${VN_ROOT}
EOF
}

day_arg(){ echo "${1:-$(date +%Y-%m-%d)}"; }

cmd_devices(){
  echo "${BOLD}Audio input devices${OFF}"
  ffmpeg -f avfoundation -list_devices true -i "" 2>&1 \
    | awk '/audio devices/,0' | grep -E '^\[' | sed 's/\[AVFoundation[^]]*\] //'
  echo
  echo "Set VN_DEVICE_NAME in ${VN_CONF} to match one by name."
}

cmd_doctor(){
  echo "${BOLD}VoiceNotes doctor${OFF}"
  command -v ffmpeg   >/dev/null && ok "ffmpeg $(ffmpeg -version | head -1 | awk '{print $3}')" || no "ffmpeg missing — brew install ffmpeg"
  command -v whisper-cli >/dev/null && ok "whisper-cli present" || no "whisper-cpp missing — brew install whisper-cpp"
  command -v python3  >/dev/null && ok "python3 present" || no "python3 missing"

  [ -f "$VN_MODEL" ] && ok "model $(basename "$VN_MODEL") ($(du -h "$VN_MODEL" | cut -f1))" \
                     || no "model missing — run: vn setup-model"
  [ -f "$VN_CONF" ]  && ok "config $VN_CONF" || warn "no config, using defaults"

  if IDX=$(vn_device_index); then ok "input device [$IDX] ${VN_DEVICE_NAME:-<system default>}"
  else no "input device '${VN_DEVICE_NAME}' not found — run: vn devices"; fi

  # Mic permission: a 1s probe that is silent at exactly -91dB means TCC denied.
  local t; t=$(mktemp).wav
  if ffmpeg -hide_banner -loglevel error -f avfoundation -i ":${IDX:-0}" -t 1 -ac 1 -ar 16000 -y "$t" 2>/dev/null; then
    local pk; pk=$(vn_peak_db "$t")
    if [ "$pk" = "-91.0" ] || [ -z "$pk" ]; then no "mic returns digital silence — grant Microphone permission"
    else ok "microphone captured audio (peak ${pk} dB)"; fi
  else no "could not open the input device"
  fi
  rm -f "$t"

  local avail; avail=$(df -h "$VN_ROOT" 2>/dev/null | tail -1 | awk '{print $4}')
  echo "  ${DIM}disk available: ${avail:-unknown} — budget ~1 GB per recorded day${OFF}"

  launchctl list 2>/dev/null | grep -q voicenotes.record \
    && ok "daily schedule active (${VN_START_HOUR}:00)" || warn "schedule not active — vn schedule on"
}

cmd_start(){
  if pgrep -qf "avfoundation"; then warn "already recording"; return 1; fi
  nohup "$VN_LIB/record.sh" ${1:+"$1"} >/dev/null 2>&1 &
  sleep 1
  pgrep -qf "avfoundation" && ok "recording started" || no "failed to start — see $VN_ROOT/logs/"
}

cmd_stop(){
  if pkill -f "avfoundation" 2>/dev/null; then ok "recording stopped"
  else warn "nothing was recording"; fi
}

cmd_status(){
  local DAY; DAY=$(date +%Y-%m-%d)
  if pgrep -qf "avfoundation"; then ok "recording now"; else echo "  not recording"; fi
  local segs txts
  segs=$(ls "$VN_ROOT/audio/$DAY"/seg-*.wav 2>/dev/null | wc -l | tr -d ' ')
  txts=$(ls "$VN_ROOT/transcripts/$DAY"/*.txt 2>/dev/null | wc -l | tr -d ' ')
  echo "  today: ${segs} segments, ${txts} transcribed"
  [ -d "$VN_ROOT/notes/$DAY" ] && echo "  notes: $VN_ROOT/notes/$DAY"
  echo "  data:  $(du -sh "$VN_ROOT" 2>/dev/null | cut -f1) in $VN_ROOT"
  launchctl list 2>/dev/null | grep -q voicenotes.record \
    && echo "  schedule: on (${VN_START_HOUR}:00 weekdays)" || echo "  schedule: off"
}

cmd_notes(){
  local DAY; DAY=$(day_arg "${1:-}")
  local CAL="$VN_ROOT/calendar/$DAY.json"
  if [ ! -f "$CAL" ]; then
    warn "no calendar for $DAY — notes will have no meeting structure"
    echo "  ${DIM}see docs/calendar.md to populate $CAL${OFF}"
  fi
  VN_ROOT="$VN_ROOT" python3 "$VN_LIB/make-notes.py" "$DAY"
}

cmd_show(){
  local DAY; DAY=$(day_arg "${1:-}")
  local IDX="$VN_ROOT/notes/$DAY/00-index.md"
  [ -f "$IDX" ] && cat "$IDX" || echo "no notes for $DAY — run: vn notes $DAY"
}

# Full day's transcript as one stream, in time order.
cmd_read(){
  local DAY; DAY=$(day_arg "${1:-}")
  local T="$VN_ROOT/transcripts/$DAY"
  if [ ! -d "$T" ] || ! ls "$T"/*.txt >/dev/null 2>&1; then
    echo "no transcripts for $DAY"; return 1
  fi
  local n; n=$(cat "$T"/*.txt 2>/dev/null | grep -c . )
  echo "${BOLD}Transcript — $DAY${OFF}  ${DIM}($n lines)${OFF}"
  echo
  cat "$T"/*.txt 2>/dev/null | grep .
}

# One meeting's note, by number or by name fragment.
cmd_note(){
  local DAY N; DAY=$(date +%Y-%m-%d); N="${1:-}"
  if [[ "${2:-}" != "" ]]; then DAY="$1"; N="$2"; fi
  local D="$VN_ROOT/notes/$DAY"
  [ -d "$D" ] || { echo "no notes for $DAY"; return 1; }
  if [ -z "$N" ]; then cmd_show "$DAY"; return; fi
  local f
  f=$(ls "$D"/*.md 2>/dev/null | grep -iE "/(0*$N-|[0-9]+-[^/]*$N)" | head -1)
  [ -z "$f" ] && f=$(grep -ril "$N" "$D"/*.md 2>/dev/null | head -1)
  [ -n "$f" ] && cat "$f" || echo "no note matching '$N' on $DAY"
}

cmd_open(){
  local DAY; DAY=$(day_arg "${1:-}")
  local D="$VN_ROOT/notes/$DAY"
  [ -d "$D" ] || D="$VN_ROOT"
  open "$D"
}

cmd_today(){
  "$VN_LIB/transcribe.sh"
  cmd_notes
  echo; cmd_show
}

cmd_schedule(){
  local action="${1:-}" plist="$HOME/Library/LaunchAgents"
  case "$action" in
    on)
      "$VN_LIB/../bin/vn-install-schedule" 2>/dev/null || {
        no "schedule installer not found; see docs/install.md"; return 1; }
      ;;
    off)
      launchctl bootout "gui/$UID/com.voicenotes.record" 2>/dev/null
      launchctl bootout "gui/$UID/com.voicenotes.transcribe" 2>/dev/null
      ok "schedule disabled"
      ;;
    *) echo "usage: vn schedule on|off"; return 1;;
  esac
}

cmd_setup_model(){
  vn_dirs
  local url="https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-large-v3-turbo.bin"
  [ -f "$VN_MODEL" ] && { ok "model already present"; return 0; }
  echo "Downloading large-v3-turbo (~1.5 GB)…"
  curl -L --progress-bar -o "$VN_MODEL" "$url" && ok "model ready at $VN_MODEL"
}

cmd_uninstall(){
  cmd_schedule off
  rm -f "$HOME/Library/LaunchAgents/com.voicenotes."*.plist
  ok "schedule removed. Your data in $VN_ROOT was left untouched."
}

vn_dirs
case "${1:-}" in
  start)        shift; cmd_start "${1:-}";;
  stop)         cmd_stop;;
  status)       cmd_status;;
  devices)      cmd_devices;;
  doctor)       cmd_doctor;;
  transcribe)   shift; "$VN_LIB/transcribe.sh" "${1:-}";;
  notes)        shift; cmd_notes "${1:-}";;
  today)        cmd_today;;
  show)         shift; cmd_show "${1:-}";;
  read)         shift; cmd_read "${1:-}";;
  note)         shift; cmd_note "${1:-}" "${2:-}";;
  open)         shift; cmd_open "${1:-}";;
  schedule)     shift; cmd_schedule "${1:-}";;
  purge)        "$VN_LIB/purge.sh";;
  setup-model)  cmd_setup_model;;
  uninstall)    cmd_uninstall;;
  ""|-h|--help|help) usage;;
  *) echo "unknown command: $1"; echo; usage; exit 1;;
esac

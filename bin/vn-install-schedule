#!/usr/bin/env bash
# Installs the launchd agents that run VoiceNotes on a schedule.
# Separated from `vn` so the privileged step is explicit and auditable.
set -uo pipefail
VN_LIB="$(cd "$(dirname "${BASH_SOURCE[0]}")/../lib" && pwd)"
source "$VN_LIB/common.sh"

LA="$HOME/Library/LaunchAgents"
mkdir -p "$LA"

# Build one <dict> per configured weekday
intervals=""
for d in $VN_WEEKDAYS; do
  intervals="$intervals
    <dict><key>Weekday</key><integer>$d</integer><key>Hour</key><integer>$VN_START_HOUR</integer><key>Minute</key><integer>0</integer></dict>"
done

cat > "$LA/com.voicenotes.record.plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.voicenotes.record</string>
  <key>ProgramArguments</key>
  <array><string>$VN_LIB/record.sh</string></array>
  <key>EnvironmentVariables</key>
  <dict><key>VN_CONF</key><string>$VN_CONF</string></dict>
  <key>StartCalendarInterval</key>
  <array>$intervals
  </array>
  <key>StandardErrorPath</key><string>$VN_ROOT/logs/launchd-record.err</string>
  <key>RunAtLoad</key><false/>
</dict></plist>
EOF

cat > "$LA/com.voicenotes.transcribe.plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.voicenotes.transcribe</string>
  <key>ProgramArguments</key>
  <array><string>$VN_LIB/transcribe.sh</string></array>
  <key>EnvironmentVariables</key>
  <dict><key>VN_CONF</key><string>$VN_CONF</string></dict>
  <key>StartInterval</key><integer>600</integer>
  <key>StandardErrorPath</key><string>$VN_ROOT/logs/launchd-transcribe.err</string>
  <key>Nice</key><integer>10</integer>
</dict></plist>
EOF

cat > "$LA/com.voicenotes.purge.plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.voicenotes.purge</string>
  <key>ProgramArguments</key>
  <array><string>$VN_LIB/purge.sh</string></array>
  <key>EnvironmentVariables</key>
  <dict><key>VN_CONF</key><string>$VN_CONF</string></dict>
  <key>StartCalendarInterval</key>
  <array><dict><key>Hour</key><integer>$(( VN_END_HOUR + 2 ))</integer><key>Minute</key><integer>30</integer></dict></array>
  <key>StandardErrorPath</key><string>$VN_ROOT/logs/launchd-purge.err</string>
  <key>Nice</key><integer>15</integer>
</dict></plist>
EOF

for job in record transcribe purge; do
  launchctl bootout "gui/$UID/com.voicenotes.$job" 2>/dev/null
  launchctl bootstrap "gui/$UID" "$LA/com.voicenotes.$job.plist" 2>/dev/null \
    && echo "✓ com.voicenotes.$job" \
    || echo "✗ com.voicenotes.$job failed to load"
done

echo
echo "Recording will start at ${VN_START_HOUR}:00 on weekdays ${VN_WEEKDAYS// /, } and stop at ${VN_END_HOUR}:00."
echo "Disable any time with: vn schedule off"
